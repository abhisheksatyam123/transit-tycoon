{
  "name": "transit-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser transport-simulation game inspired by OpenTTD",
  "scripts": {
    "dev": "bun server.js",
    "build:web": "bun tools/build-web.js",
    "check:dist": "bun tools/check-dist.js",
    "test": "bun test",
    "check": "bun tools/check-imports.js",
    "simulate": "bun tools/simulate-city.js",
    "simulate:moscow": "bun tools/simulate-city.js --scenario moscow --years 1",
    "snapshot:moscow": "bun tools/moscow/snapshot.js",
    "serve:dist": "bun tools/serve-dist.js",
    "host": "sh tools/host.sh start",
    "host:status": "sh tools/host.sh status",
    "host:stop": "sh tools/host.sh stop",
    "host:check": "bun tools/check-host.js"
  }
}
